{
  "manifest_version": 3,
  "name": "My WhatsApp Theme",
  "version": "1.0",
  "description": "Customise WhatsApp chat bubbles",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scroll-ends.png", "incoming-scroll.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
